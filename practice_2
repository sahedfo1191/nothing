class Student :
    def __init__(self,student_id,name,marks) :
        self.id=student_id
        self.name=name
        self.marks=marks
        
    def average(self) :
        return sum(self.marks.values())/len(self.marks)
        
    def highest_mark(self) :
        return max(self.marks.values())
        
    def lowest_mark(self) :
        return min(self.marks.values())
        
    def status(self) :
        if self.average() >=50 :
            return "pass"
        else :
            return "fail"
            
def validate_student(student) :
    try :
        if not isinstance(student,dict) :
            return False
        if "id" not in student :
            return False
        if "name" not in student :
            return False
        if "marks" not in student :
            return False
        
        if not isinstance(student["marks"],dict) :
            return False
        if not student["marks"] :
            return False
            
        for mark in student["marks"].values() :
            mark=float(mark)
            if not 0<=mark<=100 :
                return False
        return True
    
    except (TypeError, ValueError) :
        return False
        
def create_students (data) :
    valid_students=[ ]
    for student in data :
        if validate_student(student) :
            converted_marks= {subject : float(mark) for subject,mark in student["marks"].items()}
            
            obj = Student(
            student["id"],
            student["name"],
            converted_marks
            )
            
            valid_students.append(obj)
            
        else :
            print("Skipping invalid students : ",student)
            
    return valid_students
    
def genarate_report(students) :
    if not students :
        return None
        
    passed_students = [student for student in students if student.status() =="pass"]
    
    failed_students= [student for student in students if student.status() =="fail"]
    
    high_average_students= [student for student in students if student.average() >=80]
    
    class_average= sum(student.average() for student in students)/ len(students)
    
    highest_average_student= max(students, key= lambda student : student.average())
    
    subject_totals= {}
    subject_counts={}
    
    for student in students :
        for subject,mark in student.marks.items() :
            subject_totals[subject] = (subject_totals.get(subject,0) + mark)
            
            subject_counts[subject] = (subject_counts.get(subject,0) + 1)
            
    subject_averages = { subject : subject_totals[subject]/ subject_counts[subject] for subject in subject_totals }
    
    return {
    "passed_count" : len(passed_students),
    "failed_count" : len(failed_students),
    "high_average_students" : high_average_students,
    "class_average" : class_average,
    "subject_totals" : subject_totals,
    "subject_averages" : subject_averages,
    "highest_average_student" : highest_average_student
    }
    
valid_students= create_students(students)

