def validate_emp(emp):
    try:
        if not isinstance(emp, dict):
            return False

        required = [
            "id",
            "name",
            "department",
            "salary",
            "scores"
        ]

        for item in required:
            if item not in emp:
                return False

        salary = int(emp["salary"])
        scores = emp["scores"]

        if salary <= 0:
            return False

        if not isinstance(scores, list):
            return False

        if not scores:
            return False

        for score in scores:

            if not isinstance(score, (int, float)):
                return False

            if score < 0 or score > 100:
                return False

        return True

    except (TypeError, ValueError):
        return False


def analyze_emp(employees):

    valid_emp = []

    for emp in employees:

        if validate_emp(emp):
            valid_emp.append(emp)

        else:
            print(f"Skipping invalid employee: {emp}")

    if not valid_emp:
        return None

    total_salary = 0
    total_performance = 0

    passed_emp = []
    failed_emp = []

    individual_performance = {}
    department_emp_count = {}
    department_performance_total = {}

    for emp in valid_emp:

        emp_id = emp["id"]
        salary = emp["salary"]
        department = emp["department"]
        scores = emp["scores"]

        total_salary += salary

        average_score = sum(scores) / len(scores)

        total_performance += average_score

        if average_score >= 70:
            passed_emp.append(emp)

        else:
            failed_emp.append(emp)

        individual_performance[emp_id] = average_score

        department_performance_total[department] = (
            department_performance_total.get(department, 0)
            + average_score
        )

        department_emp_count[department] = (
            department_emp_count.get(department, 0)
            + 1
        )

    average_salary = total_salary / len(valid_emp)

    average_performance = (
        total_performance / len(valid_emp)
    )

    highest_performer = max(
        individual_performance,
        key=individual_performance.get
    )

    highest_salary_employee = max(
        valid_emp,
        key=lambda emp: emp["salary"]
    )

    department_average_performance = {}

    for department, total in department_performance_total.items():

        department_average_performance[department] = (
            total / department_emp_count[department]
        )

    return {
        "total_employees": len(valid_emp),

        "average_salary": average_salary,

        "average_performance": average_performance,

        "highest_performer": highest_performer,

        "highest_salary_employee": highest_salary_employee,

        "passed_employees": passed_emp,

        "failed_employees": failed_emp,

        "individual_performance": individual_performance,

        "department_employee_count": department_emp_count,

        "department_average_performance":
            department_average_performance
    }


