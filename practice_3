def validate_log(log) :
    if not isinstance (log,dict) :
        return False
    
    if "level" not in log :
        return False
        
    if "user" not in log :
        return False
        
    if "action" not in log :
        return False
        
    valid_levels= {"INFO","ERROR","WARNING","DEBUG"}
    
    if log["level"] not in valid_levels :
        return False
        
    return True
    
def analyze_logs(logs) :
    valid_logs = [ ]
    
    for log in logs :
        if validate_log(log) :
            valid_logs.append(log)
            
    if not valid_logs :
        return None
        
    level_count= {}
    user_count= {}
    
    error_user=set()
    failed_action=[]
    
    error_count= 0
    warning_count= 0
    login_count= 0
    
    for log in valid_logs :
        level=log["level"]
        user=log["user"]
        action=log["action"]
        
        level_count[level]=level_count.get(level,0)+1
        
        user_count[user]=user_count.get(user,0)+1
        
        if level=="WARNING" :
            warning_count+=1
        
        if level=="ERROR" :
            error_count+=1
            error_user.add(user)
            
        if action=="login" :
            login_count+=1
            
        if "failed" in action or "error" in action :
            failed_action.append(action)
            
    most_active_user=max(user_count,key=user_count.get)
        
    return {
        "total_logs" : len(valid_logs),
        "level_count" : level_count,
        "user_count" : user_count,
        "error_user" : list(error_user),
        "warning_count" : warning_count,
        "error_count" : error_count,
        "login_count" : login_count,
        "failed_action" : failed_action,
        "most_active_user" : most_active_user
        }
        
report= analyze_logs(logs)

