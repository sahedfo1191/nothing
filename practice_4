def validate_products(product):
    try:
        if not isinstance(product, dict):
            return False

        if "id" not in product:
            return False

        if "name" not in product:
            return False

        if "category" not in product:
            return False

        if "price" not in product:
            return False

        if "stock" not in product:
            return False

        id = int(product["id"])
        price = int(product["price"])
        stock = int(product["stock"])

        if price <= 0:
            return False

        if stock < 0:
            return False

        return True

    except (TypeError, ValueError):
        return False


def analyze_inventory(products):

    valid_products = []

    for product in products:
        if validate_products(product):
            valid_products.append(product)
        else:
            print(f"Skipping invalid product {product}")

    if not valid_products:
        return None

    # Inventory Report

    total_stock = 0
    total_price = 0
    total_inventory_value = 0

    out_of_stock = []
    low_stock = []

    product_value = {}
    category_stock = {}
    category_value = {}

    for product in valid_products:

        price = product["price"]
        stock = product["stock"]
        name = product["name"]
        id = product["id"]
        category = product["category"]

        total_stock += stock
        total_price += price

        total_inventory_value += price * stock

        # Stock report

        if stock == 0:
            out_of_stock.append(name)

        if stock < 10:
            low_stock.append(product)

        # Each product value

        product_value[id] = price * stock

        # Category stock

        category_stock[category] = (
            category_stock.get(category, 0) + stock
        )

        # Category value

        category_value[category] = (
            category_value.get(category, 0) + (price * stock)
        )

    # Highest stock product

    highest_stock_product = max(
        valid_products,
        key=lambda product: product["stock"]
    )

    # Highest value product

    highest_value_id = max(
        product_value,
        key=product_value.get
    )

    highest_value_product = None

    for product in valid_products:
        if product["id"] == highest_value_id:
            highest_value_product = product
            break

    return {
        "total_products": len(valid_products),
        "total_stock": total_stock,
        "total_inventory_value": total_inventory_value,
        "average_price": total_price / len(valid_products),
        "out_of_stock": out_of_stock,
        "low_stock": low_stock,
        "highest_stock_product": highest_stock_product,
        "highest_value_product": highest_value_product,
        "each_product_value": product_value,
        "category_stock": category_stock,
        "category_value": category_value
    }


