def validate_order(order):

    try:

        if not isinstance(order, dict):
            return False

        required = [
            "order_id",
            "customer",
            "items",
            "status"
        ]

        for key in required:

            if key not in order:
                return False

        items = order["items"]

        if not isinstance(items, list):
            return False

        if not items:
            return False

        item_required = [
            "name",
            "price",
            "quantity"
        ]

        for item in items:

            if not isinstance(item, dict):
                return False

            for key in item_required:

                if key not in item:
                    return False

            price = int(item["price"])
            quantity = int(item["quantity"])

            if price <= 0:
                return False

            if quantity <= 0:
                return False

        if order["status"] not in [
            "completed",
            "cancelled"
        ]:
            return False

        return True

    except (TypeError, ValueError):

        return False


def process_orders(orders):

    valid_orders = []

    for order in orders:

        if validate_order(order):
            valid_orders.append(order)

        else:
            print(
                f"Skipping invalid order: "
                f"{order.get('order_id', 'Unknown')}"
            )

    completed_orders = []
    cancelled_orders = []

    for order in valid_orders:

        if order["status"] == "completed":
            completed_orders.append(order)

        elif order["status"] == "cancelled":
            cancelled_orders.append(order)

    customer_spending = {}
    product_quantities = {}
    order_values = {}

    for order in completed_orders:

        order_id = order["order_id"]
        customer = order["customer"]
        items = order["items"]

        order_total = 0

        for item in items:

            item_total = (
                item["price"] * item["quantity"]
            )

            order_total += item_total

            customer_spending[customer] = (
                customer_spending.get(customer, 0)
                + item_total
            )

            product_quantities[item["name"]] = (
                product_quantities.get(item["name"], 0)
                + item["quantity"]
            )

        order_values[order_id] = order_total

    total_revenue = sum(
        customer_spending.values()
    )

    average_order_value = (
        total_revenue / len(completed_orders)
    )

    highest_value_order = max(
        order_values,
        key=order_values.get
    )

    most_sold_product = max(
        product_quantities,
        key=product_quantities.get
    )

    return {

        "total_orders":
            len(valid_orders),

        "completed_orders":
            len(completed_orders),

        "cancelled_orders":
            len(cancelled_orders),

        "total_revenue":
            total_revenue,

        "average_order_value":
            average_order_value,

        "highest_value_order":
            highest_value_order,

        "customer_spending":
            customer_spending,

        "product_quantities":
            product_quantities,

        "most_sold_product":
            most_sold_product
    }


