def average_score_by_grade(students) :
    score_by_grade={}
    for student in students :
        grade=student["grade"]
        score=student["score"]
        if grade not in score_by_grade :
            score_by_grade[grade]=[ ]
        score_by_grade[grade].append(score)
        
    averages = {}
    for grade,scores in score_by_grade.items() :
            averages[grade] = sum(scores)/len(scores)
            
            print(f"{grade} : {averages[grade] : .2f} ")
            
    return averages
    
