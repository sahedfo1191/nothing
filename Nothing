            filtered_students.append(student)
    if not filtered_students :
        print("No student found")
        return [ ]        
    for i,student in enumerate(filtered_students,start=1) :
        print(f"{i}. {student['name']} --- {student['score']}")
        
    return filtered_students
    
def sort_students_by_score(students, descending=True) :
    sorted_students=sorted(students, key=lambda student : student["score"], reverse=descending)
    for i,student in enumerate(sorted_students, start=1) :
        print(f"{i}. {student['name']} --- {student['score']} ")
    return sorted_students


def top_students(sorted_students,n) :
    top=sorted_students[:n]
    for i,student in enumerate(top,start=1) :
        print(f"{i}. {student['name']} ---- {student['score']}")
    return top
    
